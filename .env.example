# --- Required (Stage 1+) -----------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of this app (used in auth e-mail redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later stages (server-only, never prefix with NEXT_PUBLIC_) ------------------
# Stage 4/7 admin + PDF jobs
# SUPABASE_SERVICE_ROLE_KEY=
# Stage 5 AI defect assistant (vision model)
# ANTHROPIC_API_KEY=
# Stage 6 payments (test mode until live credentials exist)
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
