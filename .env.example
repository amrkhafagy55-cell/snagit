# --- Required (Stage 1+) -----------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Public URL of this app (used in auth e-mail redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later stages (server-only, never prefix with NEXT_PUBLIC_) ------------------
# Server-only Supabase key (Project Settings -> API -> service_role / secret key).
# Needed for payments: only the server writes payments and grants plans. NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# Stage 5 AI defect assistant (optional). Without a key the assistant is hidden.
# Create a key at https://console.anthropic.com → API keys.
# ANTHROPIC_API_KEY=
# Max AI requests per user per 24 h (default 30)
# AI_DAILY_LIMIT=30
# Stage 6 payments - Paymob Egypt (Dashboard -> Settings -> Account info). Use TEST keys
# (egy_sk_test_..., egy_pk_test_...) and TEST integration IDs until you go live. Without these,
# no buy buttons are shown. Webhook URL to set in Paymob: <SITE_URL>/api/payments/paymob/webhook
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_HMAC_SECRET=
# Comma-separated integration IDs (e.g. card,wallet): 1234567,1234568
# PAYMOB_INTEGRATION_IDS=
# PAYMOB_API_BASE=https://accept.paymob.com
